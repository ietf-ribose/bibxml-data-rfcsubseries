      <author>
        <organization>RFC Publisher</organization>
      </author>
      <author>
        <organization>RFC Series</organization>
      </author>
      <date month="August" year="2026"/>
      <workgroup>Web Authorization Protocol</workgroup>
      <keyword>JavaScript</keyword>
      <keyword>JS</keyword>
      <keyword>Single-Page App</keyword>
      <keyword>SPA</keyword>
      <abstract>
        <t>This specification details the threats, attack consequences, security considerations, and best practices that must be taken into account when developing browser-based applications that use OAuth 2.0.</t>
      </abstract>
    </front>
  </reference>
